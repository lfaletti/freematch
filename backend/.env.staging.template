# FreeMatch - Staging environment variables
# Copy to .env and fill in real values before deploying to staging.
# IMPORTANT: Never commit this file with real secrets.

# --- Server ---------------------------------------------------------------
PORT=3000
NODE_ENV=staging

# --- Database (PostgreSQL) -------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/freematch_staging

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://host:6379

# --- Auth --------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=<generate-a-random-secret>

# --- Email (Resend) ----------------------------------------------------------
# Transactional email for verification + password reset.
# Create an account at https://resend.com (free: 3,000 emails/mo).
# EMAIL_FROM must be a verified domain/address in Resend.
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=FreeMatch <no-reply@examplE.com>
FRONTEND_URL=https://YOUR-PROJECT.vercel.app

# --- CORS ---------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:8081

# --- Storage (S3-compatible) -------------------------------------------------
# Production: Cloudflare R2 credential placeholders (fill with real account IDs).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=<your-key>
AWS_SECRET_ACCESS_KEY=<your-secret>
AWS_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=https://pub-<public-hash>.r2.dev
S3_BUCKET=freematch-staging

# --- Rate Limiting -------------------------------------------------------------
# Defaults are reasonable; override if needed.
# RATE_LIMIT_AUTH_WINDOW_MS=900000     # 15 minutes
# RATE_LIMIT_AUTH_MAX=30
# RATE_LIMIT_SWIPE_WINDOW_MS=60000     # 1 minute
# RATE_LIMIT_SWIPE_MAX=60
# RATE_LIMIT_API_WINDOW_MS=900000      # 15 minutes
# RATE_LIMIT_API_MAX=200

# --- Location Services ----------------------------------------------------------
# Geoapify API key for city autocomplete (free tier: 3000 req/day).
# Get your key at https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=

# --- Donations -----------------------------------------------------------------
# Comma-separated email whitelist (only used while ENABLED_FOR_ALL=false).
# Never commit real emails here.
DONATION_ALLOWED_EMAILS=
# Set to true to let every user see the donate entry.
DONATION_ENABLED_FOR_ALL=false
