# FreeMatch — Staging environment variables
# Copy to .env and fill in real values before deploying to staging.
# ⚠️  Never commit this file with real secrets.

# ── Server ──────────────────────────────────────────────
PORT=3000
NODE_ENV=staging

# ── Database (PostgreSQL) ───────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/freematch_staging

# ── Redis ───────────────────────────────────────────────
REDIS_URL=redis://host:6379

# ── Auth ────────────────────────────────────────────────
JWT_SECRET=<generate-a-strong-random-string>

# ── CORS ────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:8081

# ── Storage (S3-compatible) ─────────────────────────────
# For staging with local MinIO:
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9002
S3_BUCKET=REDACTED_RW_ENV

# For staging with Cloudflare R2 (uncomment and fill):
# AWS_REGION=auto
# AWS_ACCESS_KEY_ID=<r2-access-key>
# AWS_SECRET_ACCESS_KEY=<r2-secret-key>
# AWS_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_PUBLIC_ENDPOINT=https://pub-<public-hash>.r2.dev
# S3_BUCKET=REDACTED_RW_ENV

# ── Rate Limiting ────────────────────────────────────────
# Defaults are reasonable; override if needed.
# RATE_LIMIT_AUTH_WINDOW_MS=900000     # 15 minutes
# RATE_LIMIT_AUTH_MAX=30
# RATE_LIMIT_SWIPE_WINDOW_MS=60000     # 1 minute
# RATE_LIMIT_SWIPE_MAX=60
# RATE_LIMIT_API_WINDOW_MS=900000      # 15 minutes
# RATE_LIMIT_API_MAX=200

# ── Location Services ───────────────────────────────────
# Geoapify API key for city autocomplete (free tier: 3000 req/day)
# Get your key at https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=
