# Production environment variables for FreeMatch backend
# Copy to .env.production and fill in real values before deploying to Railway.

PORT=3000
NODE_ENV=production

# === AUTH ===
JWT_SECRET=<generate-with: openssl rand -hex 32>

# === DATABASE ===
DATABASE_URL=postgresql://user:password@db-host:5432/freematch_db

# === REDIS (for Socket.io adapter) ===
REDIS_URL=redis://redis-host:6379

# === CORS ===
# Comma-separated list of frontend origins
CORS_ORIGIN=https://freematch.vercel.app,https://freematch-production.up.railway.app

# === DONATIONS ===
# Comma-separated email whitelist that may see the donate feature
# (only used while DONATION_ENABLED_FOR_ALL=false). Never commit real emails here.
DONATION_ALLOWED_EMAILS=
# Set to true to let every user see the donate entry.
DONATION_ENABLED_FOR_ALL=false

# === S3 / R2 for production photos ===
AWS_ACCESS_KEY_ID=<your-key>
AWS_SECRET_ACCESS_KEY=<your-secret>
AWS_REGION=us-east-1
S3_BUCKET=freematch-prod
S3_PUBLIC_ENDPOINT=https://your-r2-or-s3-public-url

# === NSFW photo moderation ===
# Optional: URL to the nsfwjs model weights (model.json + shards) hosted on
# your own storage (e.g. R2). Set this in production so the moderation model
# loads from your infra instead of the public Google CDN, making cold boots
# deterministic and independent of third-party availability.
# Leave unset to use nsfwjs's default hosted MobileNetV2 model.
# NSFW_MODEL_URL=https://your-r2-or-s3-public-url/nsfw/model.json

# Optional: custom S3-compatible endpoint (e.g. Cloudflare R2)
# AWS_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
